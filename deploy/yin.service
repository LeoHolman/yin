[Unit]
Description=Yin Next App
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/yin/app
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/yin.env
ExecStart=/root/.nvm/versions/node/v20.20.2/bin/node /var/www/yin/app/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target