[Unit]
Description=Yin Next App
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/yin/app
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/yin.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
ExecStart=/bin/bash -lc 'cd /var/www/yin/app && exec npm start'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target